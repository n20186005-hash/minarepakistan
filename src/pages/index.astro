---
import '../styles/global.css';

const DOMAIN = 'minarepakistan.com';
const LAT = 31.5925;
const LNG = 74.3146;

const siteUrl = Astro.site ?? new URL(`https://${DOMAIN}`);
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL('/images/hero.jpg', siteUrl).toString();

const d = {
  fullName: 'Minar-e-Pakistan',
  shortName: 'Minar-e-Pakistan',
  urduName: 'مینارِ پاکستان',
  city: 'Lahore',
  region: 'Punjab',
  country: 'Pakistan',
  countryCode: 'PK',
  postal: '54000',
  lat: 31.5925,
  lng: 74.3146,
  mapsUrl: 'https://maps.app.goo.gl/wK9FiYQgEEFcchqu9',
  mapsEmbed: 'https://www.google.com/maps?q=Minar-e-Pakistan,Lahore,Pakistan&output=embed',
  nearby1: 'Lahore Fort',
  nearby2: 'Badshahi Mosque',
  govtUrl: 'https://www.tourism.gov.pk/',
  punjabUrl: 'https://www.punjab.gov.pk/',
  rating: 4.6,
  reviews: 20553,
  syncMonth: '2026 年 9 月'
};

/* ----------------------------- Weather (server-side fetch + cache) ----------------------------- */
type WxDay = { dow: string; tmax: number; tmin: number; pop: number; icon: string; label: string };
type WxAdvice = { dress: string[]; act: string[]; items: string[]; risks: string[] };
type WxData = {
  current: {
    temperature_2m: number; apparent_temperature: number; relative_humidity_2m: number;
    wind_speed_10m: number; wind_direction_10m: number; weather_code: number; precipitation: number;
    windLevel: number; windText: string; uv: number;
  };
  sunrise: string;
  sunset: string;
  daily: WxDay[];
  advice: WxAdvice;
};

function wmo(code: number) {
  if (code === 0) return 'clear';
  if (code <= 2) return 'partly';
  if (code === 3) return 'cloud';
  if (code === 45 || code === 48) return 'fog';
  if (code >= 51 && code <= 57) return 'rain';
  if (code >= 61 && code <= 67) return 'rain';
  if (code >= 71 && code <= 77) return 'snow';
  if (code >= 80 && code <= 82) return 'rain';
  if (code >= 85 && code <= 86) return 'snow';
  if (code >= 95) return 'storm';
  return 'cloud';
}
function wmoLabel(code: number) {
  if (code === 0) return 'Clear';
  if (code === 1) return 'Mainly clear';
  if (code === 2) return 'Partly cloudy';
  if (code === 3) return 'Overcast';
  if (code === 45 || code === 48) return 'Fog';
  if (code >= 51 && code <= 57) return 'Drizzle';
  if (code >= 61 && code <= 67) return 'Rain';
  if (code >= 71 && code <= 77) return 'Snow';
  if (code >= 80 && code <= 82) return 'Showers';
  if (code >= 85 && code <= 86) return 'Snow showers';
  if (code >= 95) return code >= 96 ? 'Thunderstorm with hail' : 'Thunderstorm';
  return 'Cloudy';
}
function fmtTime(iso: string) {
  const t = (iso.split('T')[1] || '00:00');
  const [h, m] = t.split(':').map(Number);
  const ap = h >= 12 ? 'PM' : 'AM';
  const h12 = ((h + 11) % 12) + 1;
  return `${h12}:${String(m).padStart(2, '0')} ${ap}`;
}
function dow(iso: string) {
  const [y, mo, da] = iso.split('T')[0].split('-').map(Number);
  return ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][new Date(Date.UTC(y, mo - 1, da)).getUTCDay()];
}
function windBeaufort(kmh: number): number {
  const t = [1, 5, 11, 19, 28, 38, 49, 61, 74, 88, 102, 117];
  let lvl = 0;
  for (let i = 0; i < t.length; i++) if (kmh > t[i]) lvl = i + 1;
  return lvl;
}
function compass(deg: number): string {
  const dirs = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
  return dirs[Math.round(deg / 45) % 8];
}
function buildAdvice(o: {
  curCode: number; tmax: number; tmin: number; pop: number; windLevel: number; uv: number; humidity: number;
}): WxAdvice {
  const dress: string[] = [];
  const act: string[] = [];
  const items: string[] = [];
  const risks: string[] = [];

  const isThunder = o.curCode >= 95;
  const isHeavy = [65, 66, 67, 82, 95, 99].includes(o.curCode);
  const isRain = (o.curCode >= 51 && o.curCode <= 67) || (o.curCode >= 80 && o.curCode <= 82);
  const isLight = (o.curCode >= 51 && o.curCode <= 61) || o.curCode === 80;
  const isSunny = o.curCode <= 1;
  const isCloudy = o.curCode === 2 || o.curCode === 3;
  const isFog = o.curCode === 45 || o.curCode === 48;
  const diff = o.tmax - o.tmin;

  if (o.tmax >= 32) dress.push('It is hot — avoid the midday sun and wear light, breathable clothing');
  if (o.tmax <= 10) dress.push('Cold — bring a warm coat');
  else if (diff > 8) dress.push('Big day-to-night temperature swing — bring a layer you can add or remove');
  if (o.uv >= 5) dress.push('Strong UV — use sunscreen, sunglasses and a hat');
  if (isHeavy) dress.push('Wet and windy — wear a waterproof jacket');
  else if (isRain || o.pop >= 60) dress.push('Carry rain gear or a waterproof jacket');
  if (o.windLevel >= 7) dress.push('Strong wind — secure your hat and avoid loose clothing');
  if (isFog) dress.push('Low visibility — take care and keep warm');

  if (isThunder) risks.push('Thunderstorm — avoid lightning: do not shelter under trees, stay away from high ground and open water');
  if (isHeavy) {
    risks.push('Heavy rain — avoid low-lying areas; some outdoor facilities may close');
    act.push('Limit time outdoors; favour covered walkways and indoor exhibits');
  }
  if (o.pop >= 60) act.push('High chance of rain — plan indoor activities and keep rain gear handy');
  if (isLight && !isHeavy) act.push('Light rain — paths may be slippery, watch your step');
  if (o.tmax >= 32 && !isHeavy) act.push('Keep outdoor time short and avoid the midday heat');
  if (isSunny) act.push('Clear and pleasant — great for outdoor visits; early morning and sunset are best for photos');
  if (isCloudy) act.push('Soft light — ideal for photos and longer outdoor strolls');
  if (isFog) act.push('Poor visibility — skip long-distance views and slow your pace');
  if (o.windLevel >= 7) {
    risks.push('High wind — stay clear of hoardings, high ground and open areas');
    act.push('Elevated and waterside facilities may close — plan accordingly');
  } else if (o.windLevel >= 5) act.push('Breezy — elevated or waterside facilities may pause; check ahead');

  if (isHeavy) items.push('Raincoat (avoid long umbrellas in strong wind)');
  else if (isRain || o.pop >= 60) items.push('Umbrella / raincoat');
  if (o.tmax >= 32 || o.uv >= 5) items.push('Sunscreen');
  if (o.uv >= 5) items.push('Sunglasses, sun hat');
  if (o.tmax >= 32) items.push('Plenty of water, heat-relief items');
  if (diff > 8 || o.tmax <= 15 || isHeavy) items.push('A jacket / light layer');
  if (isFog) items.push('A mask');
  if (o.humidity >= 75 && o.tmax >= 28) items.push('A sweat towel');

  return { dress, act, items, risks };
}

let weatherCache: { ts: number; data: WxData } | null = null;
const WX_TTL = 30 * 60 * 1000;

async function getWeather(): Promise<WxData> {
  const now = Date.now();
  if (weatherCache && now - weatherCache.ts < WX_TTL) return weatherCache.data;
  const url =
    `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LNG}` +
    `&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m,precipitation` +
    `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max,sunrise,sunset` +
    `&timezone=auto&forecast_days=7`;
  const res = await fetch(url, { headers: { Accept: 'application/json' } });
  if (!res.ok) throw new Error('wx ' + res.status);
  const j: any = await res.json();
  const c = j.current;
  const curCode = c.weather_code as number;
  const windLevel = windBeaufort(c.wind_speed_10m as number);
  const windText = `${compass(c.wind_direction_10m as number)} ${windLevel}`;
  const uv = (j.daily.uv_index_max[0] as number) ?? 0;
  const daily: WxDay[] = (j.daily.time as string[]).map((t: string, i: number) => {
    const code = j.daily.weather_code[i] as number;
    return {
      dow: dow(t),
      tmax: j.daily.temperature_2m_max[i] as number,
      tmin: j.daily.temperature_2m_min[i] as number,
      pop: j.daily.precipitation_probability_max[i] as number,
      icon: wmo(code),
      label: wmoLabel(code)
    };
  });
  const d0 = daily[0];
  const advice = buildAdvice({
    curCode,
    tmax: d0.tmax,
    tmin: d0.tmin,
    pop: d0.pop,
    windLevel,
    uv,
    humidity: c.relative_humidity_2m as number
  });
  const data: WxData = {
    current: {
      temperature_2m: c.temperature_2m,
      apparent_temperature: c.apparent_temperature,
      relative_humidity_2m: c.relative_humidity_2m,
      wind_speed_10m: c.wind_speed_10m,
      wind_direction_10m: c.wind_direction_10m,
      weather_code: curCode,
      precipitation: c.precipitation ?? 0,
      windLevel,
      windText,
      uv
    },
    sunrise: j.daily.sunrise[0],
    sunset: j.daily.sunset[0],
    daily,
    advice
  };
  weatherCache = { ts: now, data };
  return data;
}

let weather: WxData | null = null;
try {
  weather = await getWeather();
} catch {
  weather = null;
}

/* ----------------------------- Structured data ----------------------------- */
const attractionLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `https://${DOMAIN}/#attraction`,
  name: d.fullName,
  alternateName: [d.shortName, d.urduName, `${d.city} ${d.fullName}`],
  description: `Comprehensive visitor guide to ${d.fullName} in ${d.city}, ${d.region}, ${d.country}: history, weather, transport, facilities and itineraries.`,
  url: `https://${DOMAIN}`,
  image: [ogImage],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: d.fullName,
    addressLocality: d.city,
    addressRegion: d.region,
    postalCode: d.postal,
    addressCountry: d.countryCode
  },
  geo: { '@type': 'GeoCoordinates', latitude: d.lat, longitude: d.lng },
  hasMap: d.mapsUrl,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: d.rating,
    reviewCount: d.reviews,
    bestRating: 5
  },
  sameAs: [d.mapsUrl, d.govtUrl, d.punjabUrl]
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    [`Where is ${d.fullName} located?`, `${d.fullName} is located inside Iqbal Park in the Walled City of ${d.city}, ${d.region}, ${d.country}, near ${d.nearby1} and ${d.nearby2}.`],
    [`Is ${d.shortName} free to visit?`, `Yes, ${d.fullName} is a public national monument and is free to visit year-round. A small ticket may apply for some facilities within the surrounding Iqbal Park grounds.`],
    [`What is ${d.fullName}?`, `${d.fullName} is the national monument of ${d.country}, built to commemorate the Lahore Resolution of 1940 that paved the way for an independent state.`],
    [`When was ${d.fullName} built?`, `The foundation stone was laid on 23 March 1940 (the date of the Lahore Resolution), and the monument was completed between 1960 and 1968.`],
    [`What are the best times to visit ${d.shortName}?`, `The cooler, clearer months from late October to March are the most comfortable. Mornings and after sunset are the most pleasant parts of the day in every season.`],
    [`How do I reach ${d.fullName}?`, `It sits inside Iqbal Park in the Walled City of ${d.city}. App-based ride-hailing or metered taxis can drop you near the park gates; the final walk to the monument is on foot through the park.`],
    [`What other landmarks are nearby?`, `Within walking distance you will find ${d.nearby1}, ${d.nearby2}, the Walled City of ${d.city}, Wazir Khan Mosque and the Shahi Hammam.`],
    [`What is the weather like in ${d.city}?`, `${d.city} has a humid subtropical climate: very hot pre-monsoon summers (May–June), a warm monsoon (July–September), and mild, dry winters (December–February) that can bring seasonal smog.`],
    [`Is parking available at ${d.shortName}?`, `Designated car and motorcycle parking areas are available inside Iqbal Park; the narrow old-city streets around the Walled City fill up quickly, so allow extra time.`],
    [`How much time should I plan for a visit?`, `A focused monument-and-park visit takes about half a day; a full day lets you combine it with the Walled City, Badshahi Mosque and Lahore Fort.`]
  ].map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } }))
};
