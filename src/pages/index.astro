<script is:inline>
  (() => {
    const toggle = document.querySelector('.nav-toggle');
    const links = document.getElementById('site-nav-links');
    if (!toggle || !links) return;
    const mobile = window.matchMedia('(max-width: 820px)');
    function close(restoreFocus = false) {
      links.hidden = mobile.matches;
      toggle.setAttribute('aria-expanded', 'false');
      if (restoreFocus && mobile.matches) toggle.focus();
    }
    function sync() {
      const focusWasInLinks = links.contains(document.activeElement);
      const focusWasToggle = document.activeElement === toggle;
      toggle.hidden = !mobile.matches;
      close(focusWasInLinks);
      if (!mobile.matches && focusWasToggle) links.querySelector('a')?.focus();
    }
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      links.hidden = expanded;
      toggle.setAttribute('aria-expanded', String(!expanded));
    });
    links.addEventListener('click', (event) => {
      const link = event.target.closest('a[href^="#"]');
      if (!link || !mobile.matches) return;
      const target = document.getElementById(link.getAttribute('href').slice(1));
      close();
      if (target) { target.setAttribute('tabindex', '-1'); target.focus({preventScroll:true}); }
      // Preserve the anchor's normal fragment/history/scroll behavior.
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.matches && !links.hidden) {
        event.preventDefault();
        close(true);
      }
    });
    mobile.addEventListener('change', sync);
    sync();
  })();
</script>

