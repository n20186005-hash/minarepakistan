---
import '../styles/global.css';
import { getWeather, wmo, wmoLabel, fmtTime, type WxData } from '../lib/weather';

const DOMAIN = 'minarepakistan.com';

const siteUrl = Astro.site ?? new URL(`https://${DOMAIN}`);
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
Astro.response.headers.set('Cache-Control', 'no-store');
const ogImage = new URL('/images/minar.jpg', siteUrl).toString();

const d = {
  fullName: 'Minar-e-Pakistan',
  shortName: 'Minar-e-Pakistan',
  urduName: 'مینارِ پاکستان',
  city: 'Lahore',
  region: 'Punjab',
  country: 'Pakistan',
  countryCode: 'PK',
  postal: '54000',
  lat: 31.5925,
  lng: 74.3146,
  mapsUrl: 'https://maps.app.goo.gl/wK9FiYQgEEFcchqu9',
  mapsEmbed: 'https://www.google.com/maps?q=Minar-e-Pakistan,Lahore,Pakistan&output=embed',
  nearby1: 'Lahore Fort',
  nearby2: 'Badshahi Mosque',
  govtUrl: 'https://www.tourism.gov.pk/',
  punjabUrl: 'https://www.punjab.gov.pk/',
  rating: 4.6,
  reviews: 20693,
  syncMonth: '29 October 2026'
};

/* ----------------------------- Weather (server-side fetch + cache) ----------------------------- */

let weather: WxData | null = null;
try {
  weather = await getWeather();
} catch {
  weather = null;
}

/* ----------------------------- Structured data ----------------------------- */
const attractionLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `https://${DOMAIN}/#attraction`,
  name: d.fullName,
  alternateName: [d.shortName, d.urduName, `${d.city} ${d.fullName}`],
  description: `Comprehensive visitor guide to ${d.fullName} in ${d.city}, ${d.region}, ${d.country}: history, weather, transport, facilities and itineraries.`,
  url: `https://${DOMAIN}`,
  image: [ogImage],
  address: {
    '@type': 'PostalAddress',
    addressLocality: d.city,
    addressRegion: d.region,
    postalCode: d.postal,
    addressCountry: d.countryCode
  },
  geo: { '@type': 'GeoCoordinates', latitude: d.lat, longitude: d.lng },
  hasMap: d.mapsUrl,
  sameAs: [d.mapsUrl]
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    [`Where is ${d.fullName} located?`, `${d.fullName} is located in Greater Iqbal Park near the Walled City of ${d.city}, ${d.region}, ${d.country}, near ${d.nearby1} and ${d.nearby2}.`],
    [`Is ${d.shortName} free to visit?`, `Current ordinary admission fees were not established from a dated operator notice. Confirm monument access, Greater Iqbal Park entry and individual facilities separately; do not assume year-round free access.`],
    [`What is ${d.fullName}?`, `${d.fullName} is the national monument of ${d.country}, built to commemorate the Lahore Resolution of 1940 that paved the way for an independent state.`],
    [`When was ${d.fullName} built?`, `Construction began on 23 March 1960 and the monument opened in October 1968. The Lahore Resolution dates to 1940; it is not the foundation date.`],
    [`What are the best times to visit ${d.shortName}?`, `Choose a currently permitted visitor time after checking the forecast, heat and air-quality warnings. Pleasant light or cooler weather does not establish opening hours or night access.`],
    [`How do I reach ${d.fullName}?`, `It sits in Greater Iqbal Park near the Walled City of ${d.city}. App-based ride-hailing or metered taxis can drop you near the park gates; the final walk to the monument is on foot through the park.`],
    [`What other landmarks are nearby?`, `Lahore Fort and Badshahi Mosque are separate nearby destinations. Delhi Gate, Wazir Khan Mosque and Shahi Hammam require their own route and visiting checks; no short continuous walk is promised.`],
    [`What is the weather like in ${d.city}?`, `${d.city} has a humid subtropical climate: very hot pre-monsoon summers (May–June), a warm monsoon (July–September), and mild, dry winters (December–February) that can bring seasonal smog.`],
    [`Is parking available at ${d.shortName}?`, `Ask the park operator about the current parking entrance, charges and available spaces; no bay or vehicle access is guaranteed by this guide.`],
    [`How much time should I plan for a visit?`, `Keep the visit flexible around confirmed access, weather and your pace. A half-day or full-day combination is a planning idea, not a measured itinerary or a guarantee that all sites are open.`],
    [`What are the current opening hours?`, `No visitor hours were displayed in the Google Maps snapshot checked 29 October 2026, and a current operator-confirmed timetable was not established. Confirm Greater Iqbal Park gates, monument/tower access and any individual facilities separately with Punjab PHA before travelling. Do not assume 24-hour or nighttime access.`],
  ].map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } }))
};
---

<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{d.fullName} {d.city} — Visitor Guide: History, Timings, Entry Fee &amp; How to Reach</title>
  <meta name="description" content={`Plan your visit to ${d.fullName} (${d.urduName}) in ${d.city}, ${d.region}, ${d.country}. Check the limits of confirmed timings and entry fees, monument history, location, transport and visitor planning.`} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={`${d.fullName} - ${d.city} Travel Guide`} />
  <meta property="og:description" content={`Independent visitor guide to ${d.fullName} in ${d.city}, ${d.region}, ${d.country}: history, weather, transport and itineraries.`} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={`${d.fullName} in ${d.city}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#8e3b24" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/favicon-180.png" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments)}
    gtag('js', new Date());
    gtag('config', 'G-HXM22WWPKP');
  </script>
</head>
<body>
<a class="skip-link" href="#main">Skip to visitor information</a>
<svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
  <symbol id="w-clear" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"/><g><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/><line x1="4.5" y1="4.5" x2="6.5" y2="6.5"/><line x1="17.5" y1="17.5" x2="19.5" y2="19.5"/><line x1="4.5" y1="19.5" x2="6.5" y2="17.5"/><line x1="17.5" y1="6.5" x2="19.5" y2="4.5"/></g>
  </symbol>
  <symbol id="w-partly" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="8" cy="8" r="3"/><line x1="8" y1="2" x2="8" y2="4"/><line x1="2" y1="8" x2="4" y2="8"/><line x1="3.8" y1="3.8" x2="5.2" y2="5.2"/><line x1="3.8" y1="12.2" x2="5.2" y2="10.8"/><path d="M7 19a3.5 3.5 0 0 1 .5-7 4.5 4.5 0 0 1 8.5-1A3 3 0 0 1 17 19Z"/>
  </symbol>
  <symbol id="w-cloud" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <path d="M7 19a4 4 0 0 1 .5-8 4.5 4.5 0 0 1 8.6-1A3.5 3.5 0 0 1 17 19Z"/>
  </symbol>
  <symbol id="w-fog" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 15a4 4 0 0 1 .5-8 4.5 4.5 0 0 1 8.6-1A3.5 3.5 0 0 1 17 15"/><line x1="4" y1="18" x2="20" y2="18"/><line x1="6" y1="21" x2="18" y2="21"/>
  </symbol>
  <symbol id="w-rain" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 15a4 4 0 0 1 .5-8 4.5 4.5 0 0 1 8.6-1A3.5 3.5 0 0 1 17 15"/><line x1="9" y1="18" x2="8" y2="21"/><line x1="13" y1="18" x2="12" y2="21"/><line x1="17" y1="18" x2="16" y2="21"/>
  </symbol>
  <symbol id="w-snow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 14a4 4 0 0 1 .5-8 4.5 4.5 0 0 1 8.6-1A3.5 3.5 0 0 1 17 14"/><line x1="12" y1="16" x2="12" y2="21"/><line x1="9.5" y1="18" x2="14.5" y2="19"/><line x1="14.5" y1="18" x2="9.5" y2="19"/>
  </symbol>
  <symbol id="w-storm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 14a4 4 0 0 1 .5-8 4.5 4.5 0 0 1 8.6-1A3.5 3.5 0 0 1 17 14"/><path d="M12 15l-2 4h3l-2 4"/>
  </symbol>
</svg>
<div class="ornament"></div>
<header class="hero">
  <nav class="nav" aria-label="Main navigation">
    <div class="shell nav-inner">
      <a class="brand" href="#top" aria-label={`${d.fullName} home`}>
        <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#1f1713"/><path d="M10 51V25h8v-8h8v8h12v-8h8v8h8v26H10Zm10 0V35h24v16" fill="#c99a48"/><path d="M26 51V39h12v12" fill="#8e3b24"/></svg>
        <span>{d.fullName}</span>
      </a>
      <button class="nav-toggle" type="button" aria-controls="site-nav-links" aria-expanded="false" hidden>Menu</button>
      <div class="nav-links" id="site-nav-links">
        <a href="#visit">Timings &amp; fees</a><a href="#about">About</a><a href="#weather">Weather</a><a href="#getting-there">Getting there</a>
        <a href="#facilities">Facilities</a><a href="#seasons">Seasons</a><a href="#itineraries">Itineraries</a>
        <a href="#history">History</a><a href="#reviews">Reviews</a><a href="#faq">FAQ</a><a href="#sources">Sources</a>
      </div>
    </div>
  </nav>
  <div class="shell hero-copy" id="top">
    <div class="kicker" style="color:#efc981">MINAR-E-PAKISTAN · {d.city} {d.postal}</div>
    <h1>{d.fullName}<br/><span style="font-size:.5em;font-weight:700">The National Monument of {d.country} · <span lang="ur" dir="rtl">{d.urduName}</span></span></h1>
    <p>Welcome to <strong>{d.fullName}</strong>, the iconic national monument in the heart of <strong>{d.city}</strong>, <strong>{d.region}</strong>, <strong>{d.country}</strong> — a primary hub for travellers exploring the Walled City and its Mughal heritage.</p>
    <a class="button" href="#about">Start the guide &rarr;</a>
    <p class="hero-credit">Historical photo: Zpotrick, 16 February 2011 · <a href="https://commons.wikimedia.org/wiki/File:Minar_e_Pakistan_(Lahore).jpg">source</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> · displayed crop. Does not confirm current access.</p>
  </div>
</header>

<section class="facts shell">
  <div class="card mini-grid">
    <div class="fact"><span>Location</span><strong>{d.city}, {d.region}</strong><small>Walled City of {d.city}, {d.postal}</small></div>
    <div class="fact"><span>Built</span><strong>1960 – 1968</strong><small>Foundation laid 23 March 1960</small></div>
    <div class="fact"><span>Entry</span><strong>Confirm fees</strong><small>Monument and park facilities differ</small></div>
  </div>
</section>

<main id="main">
<section class="section shell" id="visit"><div class="kicker">Access checked 29 October 2026</div><h2 class="section-title">Timings and entry fees: confirm before visiting</h2><p>No hours were displayed in the checked Google Maps listing. A current operator-confirmed visitor timetable or ordinary admission tariff was not established. Check the Greater Iqbal Park gates, access to the monument or tower, and individual park facilities separately with <a href="https://pha.gop.pk/">Punjab PHA</a>. Do not assume free year-round entry, tower ascent or night access.</p><p>Lahore Division describes the surrounding Greater Iqbal Park and its lake, fountain and other facilities; that project description does not establish today’s individual operating times or prices.</p></section>
{weather && (
  <section class="section" id="weather" style="background:#eef3f4">
    <div class="shell">
      <div class="kicker" style="color:#2f6f7a">Model estimate for {d.city}</div>
      <h2 class="section-title">Weather at {d.shortName}</h2>

      <div class="wx-basic card">
        <svg class="wico lg" aria-hidden="true"><use href={`#w-${wmo(weather.current.weather_code)}`} /></svg>
        <div class="wx-now">
          <div class="wx-temp">{Math.round(weather.current.temperature_2m)}&deg;<span>C</span></div>
          <div class="wx-label">{wmoLabel(weather.current.weather_code)}</div>
        </div>
        <ul class="wx-stats">
          <li><span>Feels like</span><strong>{Math.round(weather.current.apparent_temperature)}&deg;</strong></li>
          <li><span>Rain chance</span><strong>{weather.daily[0].pop}%</strong></li>
          <li><span>Wind</span><strong>{weather.current.windText} ({Math.round(weather.current.wind_speed_10m)} km/h)</strong></li>
          <li><span>Humidity</span><strong>{weather.current.relative_humidity_2m}%</strong></li>
          <li><span>UV index</span><strong>{Math.round(weather.current.uv)}</strong></li>
          <li><span>Sun</span><strong>{fmtTime(weather.sunrise)} – {fmtTime(weather.sunset)}</strong></li>
        </ul>
      </div>

      {weather.advice.risks.length > 0 && (
        <div class="wx-risk">
          <b>Weather advisory:</b> {weather.advice.risks.join(' ')}
        </div>
      )}

      <div class="wx-advice">
        {weather.advice.dress.length > 0 && (
          <div class="wx-block">
            <h3>What to wear</h3>
            <ul>{weather.advice.dress.map((t) => <li>{t}</li>)}</ul>
          </div>
        )}
        {weather.advice.act.length > 0 && (
          <div class="wx-block">
            <h3>How to plan your visit</h3>
            <ul>{weather.advice.act.map((t) => <li>{t}</li>)}</ul>
          </div>
        )}
        {weather.advice.items.length > 0 && (
          <div class="wx-block">
            <h3>What to bring</h3>
            <div class="wx-items">{weather.advice.items.map((t) => <span class="pill">{t}</span>)}</div>
          </div>
        )}
      </div>

      <div class="wx-forecast">
        {weather.daily.map((day) => (
          <div class="card wx-day">
            <div class="wx-dow">{day.dow}</div>
            <svg class="wico" aria-hidden="true"><use href={`#w-${day.icon}`} /></svg>
            <div class="wx-range"><b>{Math.round(day.tmax)}&deg;</b> / {Math.round(day.tmin)}&deg;</div>
            <div class="wx-pop">{day.pop}% rain</div>
          </div>
        ))}
      </div>

      <p class="credits">Open-Meteo model forecast, not on-site observations or air-quality data. Model time: {weather.modelTime} (Asia/Karachi); retrieved {weather.fetchedAt}. Cache up to 15 minutes; reload for an update. Weather does not establish opening or facility status. <a href="https://open-meteo.com/">Open-Meteo</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
    </div>
  </section>
)}

{!weather && (
  <section class="section" id="weather" style="background:#eef3f4">
    <div class="shell">
      <h2 class="section-title">Weather at {d.shortName}</h2>
      <p>Fresh model weather is currently unavailable — please check a weather service before you travel, and revisit shortly.</p>
    </div>
  </section>
)}

<section class="section shell" id="about">
  <div class="split">
    <div>
      <div class="kicker">A monument that shaped a nation</div>
      <h2 class="section-title">About {d.fullName}</h2>
      <p><strong>{d.fullName}</strong>, also known simply as <strong>{d.shortName}</strong>, is the national monument of {d.country}, erected to mark the Lahore Resolution of 1940. Standing at the centre of Greater Iqbal Park near the Walled City of {d.city}, it draws visitors from across the country and the world.</p>
      <p class="breadcrumb">{d.fullName} &rarr; {d.city} &rarr; {d.region} &rarr; {d.country}</p>
      <div><span class="chip">Mughal heritage</span><span class="chip">National monument</span><span class="chip">Photography spot</span><span class="chip">{d.city} old city</span></div>
    </div>
    <figure class="photo-frame"><img src="/images/badshahi.jpg" width="1280" height="891" alt="Badshahi Mosque, a separate nearby landmark in Lahore" loading="lazy"/><figcaption class="credits">Badshahi Mosque · Ujphotos, 19 May 2013 · <a href="https://commons.wikimedia.org/wiki/File:Badshahi_Mosque,_Lahore._King%27s_Mosque.jpg">source</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> · Commons resize; display may crop. Historical photo, not current-access evidence.</figcaption></figure>
  </div>
</section>

<section class="section dark" id="location">
  <div class="shell">
    <div class="kicker" style="color:#e5b55f">Find it on the map</div>
    <h2 class="section-title">Location &amp; How to Visit {d.shortName} in {d.city}</h2>
    <div class="map-wrap card">
      <iframe title={`${d.fullName} Google Map`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={d.mapsEmbed}></iframe>
    </div>
    <p style="margin-top:1rem"><a class="button alt" href={d.mapsUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps</a></p>
    <p class="credits">Map data © Google. {d.fullName} is situated inside Iqbal Park, Walled City of {d.city}, {d.postal}, {d.country}.</p>
  </div>
</section>

<section class="section shell" id="landmarks">
  <div class="kicker">Explore the surroundings</div>
  <h2 class="section-title">Landmarks &amp; Attractions Around {d.shortName}</h2>
  <p>When visiting <strong>{d.fullName}</strong>, travellers can plan separate visits to surrounding historical landmarks and points of interest, including <strong>{d.nearby1}</strong> and <strong>{d.nearby2}</strong>.</p>
  <div class="gallery">
    <figure><img src="/images/minar.jpg" width="1280" height="960" alt="Minar-e-Pakistan, photographed in 2011" loading="lazy"/><figcaption class="credits">Minar-e-Pakistan · Zpotrick, 16 February 2011 · <a href="https://commons.wikimedia.org/wiki/File:Minar_e_Pakistan_(Lahore).jpg">source</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> · unmodified file, display may crop.</figcaption></figure>
    <figure><img src="/images/badshahi.jpg" width="1280" height="891" alt="Badshahi Mosque, a separate attraction" loading="lazy"/><figcaption class="credits">Badshahi Mosque · Ujphotos, 19 May 2013 · <a href="https://commons.wikimedia.org/wiki/File:Badshahi_Mosque,_Lahore._King%27s_Mosque.jpg">source</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> · Commons resize, display may crop.</figcaption></figure>
    <figure><img src="/images/wazir.jpg" width="1280" height="1264" alt="Wazir Khan Mosque viewed through its entrance, a separate old-city destination" loading="lazy"/><figcaption class="credits">Wazir Khan Mosque · Shahbaz Aslam, 6 February 2016 · <a href="https://commons.wikimedia.org/wiki/File:Wazir_khan_mosque_entry.jpg">source</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · Commons resize, display may crop.</figcaption></figure>
  </div><p class="credits">Historical architectural photos do not establish current access or facilities. Delhi Gate remains a separate destination; its source photograph is <a href="https://commons.wikimedia.org/wiki/File:View_of_Delhi_Gate,_Lahore.jpg">credited to Umaimaumi, CC BY-SA 4.0</a> but is not delivered here. The photographed people do not endorse this guide.</p>
</section>

<section class="section" id="getting-there" style="background:#f1e7d4">
  <div class="shell">
    <div class="kicker">Plan your arrival</div>
    <h2 class="section-title">Getting to {d.shortName}</h2>
    <p>Greater Iqbal Park and the monument lie near the Walled City. The last stretch is pedestrian, so most visitors are dropped at a park gate and walk in. Below are the common ways in.</p>
    <div class="info-grid">
      <div class="card">
        <h3 class="block-title">From the airport</h3>
        <p>For Allama Iqbal International Airport, check the current pickup rules and available transport directly with your provider. Confirm fare, luggage, traffic allowance and the final permitted park entrance; no fixed journey time or direct airport transit service is promised.</p>
      </div>
      <div class="card">
        <h3 class="block-title">Public transit</h3>
        <p>Check current Metrobus, Orange Line or local bus routes and service times with the relevant operator. Verify the actual stop and safe last connection to the permitted park entrance, including the return service; do not assume every line stops at the monument.</p>
      </div>
      <div class="card">
        <h3 class="block-title">Taxis &amp; ride-hailing</h3>
        <p>App-based ride-hailing and metered taxis can drop passengers close to the Iqbal Park gates. Request the drop-off for &ldquo;Iqbal Park, Minar-e-Pakistan&rdquo; and allow extra time in the evening when the area is busy. The final approach to the monument is on foot through the park.</p>
      </div>
      <div class="card">
        <h3 class="block-title">Driving &amp; parking</h3>
        <p>Confirm the currently permitted approach road, parking entrance, charges and spaces with the park before driving. Agree a lawful pickup and return point; no bay or private gate access is guaranteed.</p>
      </div>
    </div>
  </div>
</section>

<section class="section shell" id="facilities">
  <div class="kicker">On-site &amp; nearby</div>
  <h2 class="section-title">Visitor Services &amp; Surrounding Facilities</h2>
  <p>This is an independent visitor-information resource. We describe the <em>types</em> of services available so you can plan; we do not endorse specific businesses. Availability and quality vary, so confirm on arrival.</p>
  <div class="info-grid">
    <div class="card"><h3 class="block-title">Restrooms (WC)</h3><p>Ask which toilets are open, their location, charge and accessibility before relying on them. Carry tissues and hygiene supplies.</p></div>
    <div class="card"><h3 class="block-title">Parking</h3><p>Ask the operator about current parking locations, entry rules, charges and spaces. Evening illumination is not a confirmed visitor timetable.</p></div>
    <div class="card"><h3 class="block-title">Food &amp; drink</h3><p>Lahore Division lists a food court in the wider park project. Verify what is open on your date, check food preparation and ingredients, and carry drinking water.</p></div>
    <div class="card"><h3 class="block-title">Lodging</h3><p>{d.city} offers hotels and guesthouses across many budgets, concentrated near the Walled City, Mall Road and the central districts. Book ahead during peak travel seasons.</p></div>
    <div class="card"><h3 class="block-title">Shopping</h3><p>The bazaars and markets of the Walled City are known for textiles, handicrafts, spices and souvenirs. Bargaining is customary; keep valuables secure in crowded lanes.</p></div>
    <div class="card"><h3 class="block-title">Fuel &amp; EV charging</h3><p>Check a current fuel or charging provider on your actual route before relying on it; no particular charging point, connector or opening time has been verified.</p></div>
  </div>
</section>

<section class="section dark" id="seasons">
  <div class="shell">
    <div class="kicker" style="color:#e5b55f">When to come</div>
    <h2 class="section-title">Seasonal Visiting Strategy</h2>
    <p>These are planning prompts, not a climate-normal dataset or a guarantee of comfortable weather. Check current Lahore forecasts, official warnings and air quality for your date; a weather forecast does not measure pollution.</p>
    <div class="table-wrap card"><table class="strategy"><thead><tr><th>Planning period</th><th>What to check</th><th>Preparation</th></tr></thead><tbody>
