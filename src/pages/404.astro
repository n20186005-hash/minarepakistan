---
import '../styles/global.css';

Astro.response.status = 404;
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Page not found | Minar-e-Pakistan guide</title>
  <meta name="theme-color" content="#8e3b24" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/favicon-180.png" />
</head>
<body>
  <div class="ornament"></div>

  <header class="site-header">
    <div class="shell site-header-inner">
      <a class="brand" href="/" aria-label="Minar-e-Pakistan home">
        <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#1f1713"/><path d="M10 51V25h8v-8h8v8h12v-8h8v8h8v26H10Zm10 0V35h24v16" fill="#c99a48"/><path d="M26 51V39h12v12" fill="#8e3b24"/></svg>
        <span>Minar-e-Pakistan</span>
      </a>
      <a class="header-link" href="/#guides">All guides &rarr;</a>
    </div>
  </header>

  <section class="topic-hero">
    <div class="shell">
      <h1>Page not found</h1>
      <p>This address does not exist in the independent visitor guide.</p>
    </div>
  </section>

  <main class="shell topic-body">
    <section class="topic-section">
      <h2>Find your way</h2>
      <p>The page may have moved or the address may be mistyped. Start from the guide homepage or browse the topic guides.</p>
      <div class="related-grid">
        <a class="card" href="/">
          <span class="related-kicker">Home</span>
          <strong>Minar-e-Pakistan visitor guide</strong>
        </a>
        <a class="card" href="/#guides">
          <span class="related-kicker">Guides</span>
          <strong>All topic guides</strong>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell">
      <div>
        <img src="/logo.svg" alt="Minar-e-Pakistan logo" width="220" height="66" />
        <p>This is an unofficial information website and is not affiliated with or endorsed by any government authority.</p>
      </div>
      <div>
        <b>Explore</b>
        <p>
          <a href="/">Home</a> · <a href="/#guides">All guides</a> · <a href="/#about">About</a> ·
          <a href="/#history">History</a> · <a href="/#getting-there">Getting there</a> · <a href="/#faq">FAQ</a>
        </p>
        <b style="margin-top:1rem;display:block">Legal</b>
        <p><a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms of Service</a> · <a href="/cookies/">Cookie Settings</a></p>
      </div>
    </div>
  </footer>
</body>
</html>
