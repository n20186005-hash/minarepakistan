---
import { getTopic } from '../data/topics';
import { DOMAIN } from '../data/site';
import { LANDMARKS } from '../data/landmarks';

interface Props {
  topic: {
    slug: string;
    group: string;
    kicker: string;
    h1: string;
    lead: string;
    updated: string;
    sections: { heading: string; body?: string[]; bullets?: string[] }[];
    faqs: { q: string; a: string }[];
    related: string[];
  };
  groupLabel: string;
}

const { topic, groupLabel } = Astro.props;
const landmark = LANDMARKS[topic.slug];

// Resolve related links to real topics (skip any unknown slug).
const related = topic.related
  .map((slug) => getTopic(slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
---

<div class="ornament"></div>

<header class="site-header">
  <div class="shell site-header-inner">
    <a class="brand" href="/" aria-label={`${DOMAIN} home`}>
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#1f1713"/><path d="M10 51V25h8v-8h8v8h12v-8h8v8h8v26H10Zm10 0V35h24v16" fill="#c99a48"/><path d="M26 51V39h12v12" fill="#8e3b24"/></svg>
      <span>Minar-e-Pakistan</span>
    </a>
    <a class="header-link" href="/#guides">All guides &rarr;</a>
  </div>
</header>

<nav class="breadcrumb-nav shell" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <span aria-hidden="true">/</span>
  <a href="/#guides">{groupLabel}</a>
  <span aria-hidden="true">/</span>
  <span class="current">{topic.h1}</span>
</nav>

<section class:list={['topic-hero', { 'landmark-hero': Boolean(landmark) }]} style={landmark ? `--landmark-image:url("${landmark.image}")` : undefined}>
  <div class="shell">
    {landmark && <span class="landmark-eyebrow">Lahore heritage · Visitor guide</span>}
    <h1>{topic.h1}</h1>
    <p>{landmark?.tagline ?? topic.lead}</p>
    {landmark && <div class="landmark-hero-meta"><span>◷ {landmark.hours}</span><span>⌖ {landmark.location}</span><a href={landmark.maps} target="_blank" rel="noopener noreferrer">View location ↗</a></div>}
  </div>
</section>

<main class="shell topic-body">
  {landmark && <>
    <nav class="landmark-jump" aria-label="On this page"><a href="#explore">Explore</a><a href="#essentials">Essentials</a><a href="#discover">Discover</a><a href="#route">Route</a><a href="#photos">Photography</a><a href="#directions">Directions</a><a href="#faq">FAQ</a></nav>
    <section class="topic-section landmark-intro" id="explore"><div><span class="kicker">Explore Lahore</span><h2>Discover {topic.h1}</h2><p>{topic.lead}</p><p>{landmark.visitorPerspective}</p></div><img src={landmark.image} alt={landmark.imageAlt} loading="lazy" onerror="this.style.display='none'" /></section>
    <section class="topic-section"><h2>Visit tips</h2><div class="landmark-card-grid">{landmark.visitTips.map((tip, i) => <article class="landmark-tip"><b>{String(i+1).padStart(2,'0')}</b><p>{tip}</p></article>)}</div></section>
    <section class="topic-section"><h2>Highlights</h2><ul class="landmark-highlight-list">{landmark.features.map((f) => <li>{f}</li>)}</ul></section>
    <section class="topic-section" id="essentials"><h2>About &amp; basic information</h2><p>{topic.lead}</p><dl class="landmark-facts"><div><dt>Attraction</dt><dd>{topic.h1}</dd></div><div><dt>Type</dt><dd>{landmark.type}</dd></div><div><dt>Location</dt><dd>{landmark.location}</dd></div><div><dt>Suggested time</dt><dd>{landmark.duration}</dd></div></dl></section>
    <section class="topic-section landmark-two"><div><h2>Opening hours</h2><p>{landmark.hours}</p><p>Confirm current access at the entrance or on the linked map before travelling, especially around public events.</p></div><div><h2>Tickets &amp; prices</h2><p>{landmark.admission}</p><p>Prices and eligibility can change; check the on-site ticket counter for the latest arrangement.</p></div></section>
    <section class="topic-section" id="discover"><h2>Discover its history, architecture &amp; culture</h2><div class="landmark-discover">{landmark.discovery.map((d, i) => <article><span>{String(i+1).padStart(2,'0')}</span><div><h3>{d.title}</h3><p>{d.text}</p></div></article>)}</div></section>
    <section class="topic-section" id="route"><h2>Recommended walking route</h2><ol class="landmark-steps">{landmark.route.map((step) => <li>{step}</li>)}</ol></section>
    <section class="topic-section landmark-two"><div><h2>Before you go</h2><ul>{landmark.etiquette.map((x) => <li>{x}</li>)}</ul></div><div id="photos"><h2>Photography viewpoints</h2><ul>{landmark.photos.map((x) => <li>{x}</li>)}</ul></div></section>
    <section class="topic-section"><h2>Where to stay</h2><p>{landmark.accommodation}</p></section>
    <section class="topic-section"><h2>Visitor perspective</h2><blockquote class="landmark-perspective">{landmark.visitorPerspective}</blockquote><p class="landmark-caption">Editorial visit-planning perspective; not a fabricated visitor review or live rating.</p></section>
    <section class="topic-section" id="directions"><h2>Getting here &amp; location</h2><p><strong>Area:</strong> {landmark.location}</p><ul>{landmark.transport.map((x) => <li>{x}</li>)}</ul><a class="landmark-map-link" href={landmark.maps} target="_blank" rel="noopener noreferrer">Open {topic.h1} in Google Maps ↗</a></section>
    <section class="topic-section landmark-original"><h2>More details for planning your visit</h2><p>Explore the historical background and practical details from this guide below.</p></section>
  </>}
  {topic.sections.map((s) => (
    <section class="topic-section">
      <h2>{s.heading}</h2>
      {s.body && s.body.map((p) => <p>{p}</p>)}
      {s.bullets && (
        <ul>
          {s.bullets.map((b) => <li>{b}</li>)}
        </ul>
      )}
    </section>
  ))}

  <section class="topic-section" id="faq">
    <h2>Frequently asked questions</h2>
    {topic.faqs.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  {related.length > 0 && (
    <section class="topic-section related">
      <h2>Related guides</h2>
      <div class="related-grid">
        {related.map((r) => (
          <a class="card" href={`/${r.slug}/`}>
            <span class="related-kicker">{r.kicker}</span>
            <strong>{r.h1}</strong>
          </a>
        ))}
      </div>
    </section>
  )}
</main>

<footer class="site-footer">
  <div class="shell">
    <div>
      <img src="/logo.svg" alt="Minar-e-Pakistan logo" width="220" height="66" />
      <p>Explore Lahore’s heritage, plan a walk between landmarks and check current visiting arrangements before setting out.</p>
    </div>
    <div>
      <b>Explore</b>
      <p>
        <a href="/">Home</a> · <a href="/#guides">All guides</a> · <a href="/#about">About</a> ·
        <a href="/#history">History</a> · <a href="/#getting-there">Getting there</a> · <a href="/#faq">FAQ</a>
      </p>
      <b style="margin-top:1rem;display:block">Legal</b>
      <p><a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms of Service</a> · <a href="/cookies/">Cookie Settings</a></p>
      <p class="credits">Nearby-landmark and monument photographs are via Wikimedia Commons (CC licenses). Map data © Google.</p>
    </div>
  </div>
</footer>
